---
import Icon from "./Icon.astro";
import type { Lang } from "../i18n/types";
import { ui } from "../i18n/ui";
import { relationLabel, statusLabel } from "../lib/format";
import type { GameView } from "../lib/data";

interface Props {
  lang: Lang;
  game: GameView;
}

const { lang, game } = Astro.props;
const t = ui[lang];
const projects = game.specificProjects;

const relations = [...new Set(projects.map((project) => project.relation))];
const statuses = [...new Set(projects.map((project) => project.status))];

const relationOrder = [
  "agent",
  "clone",
  "mod",
  "environment",
  "world-model",
  "tool"
] as const;
const statusOrder = [
  "active",
  "maintenance",
  "dormant",
  "archived",
  "unknown"
] as const;

const sortedRelations = relations.sort(
  (a, b) => relationOrder.indexOf(a) - relationOrder.indexOf(b)
);
const sortedStatuses = statuses.sort(
  (a, b) => statusOrder.indexOf(a) - statusOrder.indexOf(b)
);
---

{
  projects.length > 0 && (
    <div
      class="filter-bar"
      data-filter-bar
      data-lang={lang}
      data-total={projects.length}
    >
      <div class="filter-group">
        <span class="filter-label">{t.game.filterRelation}</span>
        {sortedRelations.map((relation) => (
          <button
            type="button"
            class="chip"
            data-filter-group="relation"
            data-filter-value={relation}
            aria-pressed="false"
          >
            {relationLabel(relation, lang)}
          </button>
        ))}
      </div>

      <div class="filter-group">
        <span class="filter-label">{t.game.filterStatus}</span>
        {sortedStatuses.map((status) => (
          <button
            type="button"
            class="chip"
            data-filter-group="status"
            data-filter-value={status}
            aria-pressed="false"
          >
            {statusLabel(status, lang)}
          </button>
        ))}
      </div>

      <label class="filter-group cursor-pointer text-[0.76rem] text-muted">
        <input type="checkbox" data-filter-requires />
        {t.game.filterRequires}
      </label>

      <label class="filter-group cursor-pointer text-[0.76rem] text-muted">
        <input type="checkbox" data-filter-browser />
        {t.game.filterBrowser}
      </label>

      <label class="filter-group text-[0.76rem] text-muted">
        <span class="filter-label">{t.game.sort}</span>
        <select class="filter-select" data-sort-select>
          <option value="activity">{t.game.sortActivity}</option>
          <option value="stars">{t.game.sortStars}</option>
          <option value="name">{t.game.sortName}</option>
        </select>
      </label>

      <button type="button" class="chip" data-clear-filters>
        <Icon name="x" size={12} />
        {t.game.clearFilters}
      </button>

      <span class="filter-count" data-filter-count>
        {t.game.showing(projects.length, projects.length)}
      </span>
    </div>
  )
}

<p class="empty-state-text mt-4 hidden text-left" data-filter-empty>
  {t.game.noFilterResults}
</p>

<script>
  // @ts-nocheck — DOM script kept in plain JS for readability.
  const bar = document.querySelector("[data-filter-bar]");
  if (bar) {
    const list = document.querySelector("[data-project-list]");
    if (list) {
      const items = [...list.querySelectorAll("[data-project]")];
      const lang = bar.dataset.lang || "es";
      const total = items.length;
      const count = bar.querySelector("[data-filter-count]");
      const empty = document.querySelector("[data-filter-empty]");
      const sortSelect = document.querySelector("[data-sort-select]");
      const requiresInput = document.querySelector("[data-filter-requires]");
      const browserInput = document.querySelector("[data-filter-browser]");
      const clearButton = document.querySelector("[data-clear-filters]");

      const state = {
        relation: null,
        status: null,
        requires: false,
        browser: false,
        sort: "activity"
      };

      const visibleLabel = (visible) =>
        lang === "es"
          ? `${visible} de ${total} ${total === 1 ? "proyecto" : "proyectos"}`
          : `${visible} of ${total} ${total === 1 ? "project" : "projects"}`;

      const setChip = (group, value) => {
        bar
          .querySelectorAll(`[data-filter-group="${group}"]`)
          .forEach((chip) => {
            chip.setAttribute(
              "aria-pressed",
              String(chip.dataset.filterValue === value)
            );
          });
      };

      const apply = () => {
        let visible = 0;
        for (const item of items) {
          const relationOk =
            !state.relation || item.dataset.relation === state.relation;
          const statusOk =
            !state.status || item.dataset.status === state.status;
          const requiresOk =
            !state.requires || item.dataset.requires === "yes";
          const browserOk =
            !state.browser || item.dataset.browser === "yes";
          const show = relationOk && statusOk && requiresOk && browserOk;
          item.hidden = !show;
          if (show) visible++;
        }

        if (empty) empty.classList.toggle("hidden", visible > 0);
        if (count) count.textContent = visibleLabel(visible);

        const sorted = [...items].sort((a, b) => {
          if (state.sort === "stars") {
            return (
              Number(b.dataset.stars || 0) - Number(a.dataset.stars || 0)
            );
          }
          if (state.sort === "name") {
            return (a.dataset.name || "").localeCompare(
              b.dataset.name || "",
              lang
            );
          }
          return (
            Number(b.dataset.activity || 0) - Number(a.dataset.activity || 0)
          );
        });
        for (const item of sorted) list.appendChild(item);

        const params = new URLSearchParams(window.location.search);
        const setOrDelete = (key, value) => {
          if (value) params.set(key, value);
          else params.delete(key);
        };
        setOrDelete("tipo", state.relation);
        setOrDelete("estado", state.status);
        setOrDelete("requiere", state.requires ? "1" : "");
        setOrDelete("navegador", state.browser ? "1" : "");
        setOrDelete("orden", state.sort === "activity" ? "" : state.sort);
        const query = params.toString();
        const url = `${window.location.pathname}${query ? `?${query}` : ""}`;
        history.replaceState(null, "", url);
      };

      bar.querySelectorAll("[data-filter-group]").forEach((chip) => {
        chip.addEventListener("click", () => {
          const group = chip.dataset.filterGroup;
          const value = chip.dataset.filterValue;
          if (group === "relation") {
            state.relation = state.relation === value ? null : value;
            setChip("relation", state.relation);
          }
          if (group === "status") {
            state.status = state.status === value ? null : value;
            setChip("status", state.status);
          }
          apply();
        });
      });

      requiresInput?.addEventListener("change", () => {
        state.requires = requiresInput.checked;
        apply();
      });

      browserInput?.addEventListener("change", () => {
        state.browser = browserInput.checked;
        apply();
      });

      sortSelect?.addEventListener("change", () => {
        state.sort = sortSelect.value;
        apply();
      });

      clearButton?.addEventListener("click", () => {
        state.relation = null;
        state.status = null;
        state.requires = false;
        state.browser = false;
        state.sort = "activity";
        setChip("relation", null);
        setChip("status", null);
        if (requiresInput) requiresInput.checked = false;
        if (browserInput) browserInput.checked = false;
        if (sortSelect) sortSelect.value = "activity";
        apply();
      });

      const params = new URLSearchParams(window.location.search);
      state.relation = params.get("tipo");
      state.status = params.get("estado");
      state.requires = params.get("requiere") === "1";
      state.browser = params.get("navegador") === "1";
      state.sort = params.get("orden") || "activity";
      if (requiresInput) requiresInput.checked = state.requires;
      if (browserInput) browserInput.checked = state.browser;
      if (sortSelect) sortSelect.value = state.sort;
      setChip("relation", state.relation);
      setChip("status", state.status);
      apply();
    }
  }
</script>
