---
import Icon from "./Icon.astro";
import { GITHUB_ISSUES } from "../config";
import type { Lang } from "../i18n/types";
import { ui } from "../i18n/ui";
import { withBase } from "../lib/url";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
const id = `site-search-${lang}`;
const hintId = `search-hint-${lang}`;
const resultsId = `search-results-${lang}`;
---

<div
  class="search-shell"
  data-search-root
  data-lang={lang}
  data-games-url={withBase(`/search/games-${lang}.json`)}
  data-projects-url={withBase(`/search/projects-${lang}.json`)}
  data-suggest-url={GITHUB_ISSUES}
>
  <form class="search-box" role="search" data-search-form>
    <Icon name="search" size={20} />
    <label class="sr-only" for={id}>{t.search.label}</label>
    <input
      id={id}
      class="search-input"
      type="search"
      name="q"
      autocomplete="off"
      spellcheck="false"
      placeholder={t.search.placeholder}
      aria-describedby={hintId}
      aria-controls={resultsId}
      data-search-input
    />
    <span class="search-kbd" aria-hidden="true">{t.search.shortcut}</span>
    <button
      type="button"
      class="search-clear"
      aria-label={t.search.clear}
      data-search-clear
    >
      <Icon name="x" size={16} />
    </button>
  </form>

  <p class="search-hint" id={hintId}>{t.search.hint}</p>

  <div
    class="search-results"
    id={resultsId}
    data-search-results
    aria-live="polite"
    hidden
  >
    <div class="search-loading" data-search-loading hidden>
      {t.search.loading}
    </div>

    <div data-search-content hidden>
      <div class="search-section-title">{t.search.games}</div>
      <ul data-game-results></ul>

      <div class="search-section-title" data-project-section hidden>
        {t.search.projects}
      </div>
      <ul data-project-results></ul>

      <div class="search-empty" data-search-empty hidden>
        <p class="font-semibold text-ink">{t.search.noResults}</p>
        <p class="mt-1">{t.search.noResultsHint}</p>
        <p class="mt-2">
          <a href={GITHUB_ISSUES} target="_blank" rel="noopener noreferrer">
            {t.search.suggest}
          </a>
        </p>
      </div>
    </div>
  </div>
</div>

<script>
  // @ts-nocheck — DOM script kept in plain JS for readability.
  import MiniSearch from "minisearch";

  const root = document.querySelector("[data-search-root]");
  if (root) {
    const input = root.querySelector("[data-search-input]");
    const clearButton = root.querySelector("[data-search-clear]");
    const results = root.querySelector("[data-search-results]");
    const loading = root.querySelector("[data-search-loading]");
    const content = root.querySelector("[data-search-content]");
    const gameList = root.querySelector("[data-game-results]");
    const projectList = root.querySelector("[data-project-results]");
    const projectSection = root.querySelector("[data-project-section]");
    const empty = root.querySelector("[data-search-empty]");
    const form = root.querySelector("[data-search-form]");

    if (
      input &&
      clearButton &&
      results &&
      loading &&
      content &&
      gameList &&
      projectList &&
      projectSection &&
      empty &&
      form
    ) {
      const lang = root.dataset.lang || "es";
      const gamesUrl = root.dataset.gamesUrl;
      const projectsUrl = root.dataset.projectsUrl;
      const wantedLabel = lang === "es" ? "Sin proyectos" : "No projects";
      const countLabel = (n) =>
        lang === "es"
          ? `${n} ${n === 1 ? "proyecto" : "proyectos"}`
          : `${n} ${n === 1 ? "project" : "projects"}`;
      const yearLabel = (year) => {
        if (year == null) return "";
        if (year < 0) {
          return lang === "es"
            ? `${Math.abs(year)} a. C.`
            : `${Math.abs(year)} BCE`;
        }
        return String(year);
      };

      const normalize = (value) =>
        value
          .normalize("NFD")
          .replace(/\p{Diacritic}/gu, "")
          .toLowerCase();

      const escapeHtml = (value) =>
        String(value ?? "").replace(/[&<>"']/g, (char) => {
          const map = {
            "&": "&amp;",
            "<": "&lt;",
            ">": "&gt;",
            '"': "&quot;",
            "'": "&#39;"
          };
          return map[char];
        });

      const highlight = (text, query) => {
        const escaped = escapeHtml(text);
        const q = query.trim();
        if (!q) return escaped;
        const index = escaped.toLowerCase().indexOf(q.toLowerCase());
        if (index === -1) return escaped;
        return `${escaped.slice(0, index)}<mark>${escaped.slice(
          index,
          index + q.length
        )}</mark>${escaped.slice(index + q.length)}`;
      };

      const badge = (label, tone = "slate") =>
        `<span class="badge badge-${tone}">${escapeHtml(label)}</span>`;

      const arrow = `
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 12h15"/><path d="m13 6 6 6-6 6"/>
        </svg>`;

      const state = {
        gameIndex: null,
        projectIndex: null,
        loaded: false,
        loadingPromise: null,
        active: -1,
        timer: 0
      };

      const hideResults = () => {
        results.hidden = true;
        content.hidden = true;
        input.removeAttribute("aria-activedescendant");
        state.active = -1;
      };

      const showLoading = () => {
        loading.hidden = false;
        content.hidden = true;
        results.hidden = false;
      };

      const hideLoading = () => {
        loading.hidden = true;
      };

      const setActive = (index) => {
        const links = [...content.querySelectorAll("[data-result]")];
        if (links.length === 0) {
          state.active = -1;
          input.removeAttribute("aria-activedescendant");
          return;
        }
        state.active = Math.max(-1, Math.min(index, links.length - 1));
        links.forEach((link, i) => {
          const active = i === state.active;
          link.dataset.active = active ? "true" : "false";
          if (active) {
            link.scrollIntoView({ block: "nearest" });
            input.setAttribute("aria-activedescendant", link.id);
          }
        });
        if (state.active === -1) {
          input.removeAttribute("aria-activedescendant");
        }
      };

      const render = (query, games, projects) => {
        gameList.innerHTML = games
          .map((game, index) => {
            const meta = [yearLabel(game.year), countLabel(game.projectCount)]
              .filter(Boolean)
              .join(" · ");
            const wanted = game.wanted
              ? badge(wantedLabel, "slate")
              : "";
            return `<li>
              <a class="search-result" href="${escapeHtml(game.url)}" data-result id="search-game-${index}" data-active="false">
                <span class="search-result-main">
                  <span class="search-result-title"><span>${highlight(game.title, query)}</span> ${wanted}</span>
                  <span class="search-result-meta">${escapeHtml(meta)}</span>
                  <span class="search-result-description">${escapeHtml(game.description)}</span>
                </span>
                ${arrow}
              </a>
            </li>`;
          })
          .join("");

        projectList.innerHTML = projects
          .map((project, index) => {
            const meta = [project.games, project.lastActivityLabel]
              .filter(Boolean)
              .join(" · ");
            const statusBadge =
              project.archived || project.status === "archived"
                ? badge(project.statusLabel, project.statusTone)
                : "";
            return `<li>
              <a class="search-result" href="${escapeHtml(project.url)}" data-result id="search-project-${index}" data-active="false">
                <span class="search-result-main">
                  <span class="search-result-title"><span>${highlight(project.name, query)}</span> ${badge(project.relationLabel, project.relationTone)} ${statusBadge}</span>
                  <span class="search-result-meta">${escapeHtml(meta)}</span>
                  <span class="search-result-description">${escapeHtml(project.description)}</span>
                </span>
                ${arrow}
              </a>
            </li>`;
          })
          .join("");

        projectSection.hidden = projects.length === 0;
        empty.hidden = games.length + projects.length > 0;
        content.hidden = false;
        results.hidden = false;
        state.active = -1;
        input.removeAttribute("aria-activedescendant");
      };

      const ensureLoaded = async () => {
        if (state.loaded) return;
        if (state.loadingPromise) return state.loadingPromise;

        state.loadingPromise = (async () => {
          const [gamesResponse, projectsResponse] = await Promise.all([
            fetch(gamesUrl, { cache: "no-cache" }),
            fetch(projectsUrl, { cache: "no-cache" })
          ]);
          if (!gamesResponse.ok || !projectsResponse.ok) {
            throw new Error("No se pudo cargar el índice de búsqueda");
          }
          const [games, projects] = await Promise.all([
            gamesResponse.json(),
            projectsResponse.json()
          ]);

          state.gameIndex = new MiniSearch({
            fields: ["title", "aliases", "genres", "platforms"],
            storeFields: [
              "title",
              "year",
              "projectCount",
              "lastActivityLabel",
              "wanted",
              "url",
              "description"
            ],
            searchOptions: {
              boost: { title: 3, aliases: 2 },
              fuzzy: 0.2,
              prefix: true,
              combineWith: "AND",
              boostDocument: (_id, _term, stored) =>
                1 +
                Math.min(Number(stored?.projectCount ?? 0), 10) * 0.03
            },
            processTerm: normalize
          });
          state.gameIndex.addAll(games);

          state.projectIndex = new MiniSearch({
            fields: ["name", "nameTokens", "description", "games", "tags", "tech"],
            storeFields: [
              "name",
              "description",
              "relationLabel",
              "relationTone",
              "status",
              "statusLabel",
              "statusTone",
              "games",
              "lastActivityLabel",
              "stars",
              "starsLabel",
              "archived",
              "url"
            ],
            searchOptions: {
              boost: { name: 3, nameTokens: 2.5, games: 2 },
              fuzzy: 0.2,
              prefix: true,
              combineWith: "AND",
              boostDocument: (_id, _term, stored) => {
                const stars = Number(stored?.stars ?? 0);
                const activityBoost =
                  stored?.archived === true ? 0.9 : 1;
                const popularity =
                  1 + Math.min(Math.sqrt(Math.max(stars, 0)) / 20, 2.5);
                return activityBoost * popularity;
              }
            },
            processTerm: normalize
          });
          state.projectIndex.addAll(projects);

          state.loaded = true;
        })();

        try {
          await state.loadingPromise;
        } catch (error) {
          console.error(error);
          state.loadingPromise = null;
        } finally {
          hideLoading();
        }
      };

      const search = async (query) => {
        if (query.length < 2) {
          hideResults();
          return;
        }
        showLoading();
        await ensureLoaded();
        hideLoading();
        if (!state.gameIndex || !state.projectIndex) {
          content.hidden = false;
          empty.hidden = false;
          projectSection.hidden = true;
          gameList.innerHTML = "";
          projectList.innerHTML = "";
          results.hidden = false;
          return;
        }
        const games = state.gameIndex.search(query).slice(0, 6);
        const projects = state.projectIndex.search(query).slice(0, 4);
        render(query, games, projects);
      };

      const scheduleSearch = (query) => {
        window.clearTimeout(state.timer);
        if (query.length < 2) {
          hideResults();
          return;
        }
        state.timer = window.setTimeout(() => {
          search(query);
        }, 80);
      };

      const updateUrl = (query) => {
        const url = new URL(window.location.href);
        if (query) {
          url.searchParams.set("q", query);
        } else {
          url.searchParams.delete("q");
        }
        history.replaceState(null, "", url);
      };

      const clear = () => {
        input.value = "";
        root.dataset.hasQuery = "false";
        updateUrl("");
        hideResults();
        input.focus();
      };

      input.addEventListener("input", () => {
        const query = input.value.trim();
        root.dataset.hasQuery = query ? "true" : "false";
        updateUrl(query);
        scheduleSearch(query);
      });

      input.addEventListener("focus", () => {
        if (input.value.trim().length >= 2) {
          search(input.value.trim());
        } else {
          ensureLoaded();
        }
      });

      input.addEventListener("keydown", (event) => {
        const links = [...content.querySelectorAll("[data-result]")];
        if (event.key === "ArrowDown") {
          event.preventDefault();
          setActive(state.active + 1);
        } else if (event.key === "ArrowUp") {
          event.preventDefault();
          setActive(state.active - 1);
        } else if (event.key === "Enter") {
          if (links.length > 0) {
            event.preventDefault();
            const target =
              state.active >= 0
                ? links[state.active]
                : links[0];
            target?.click();
          }
        } else if (event.key === "Escape") {
          event.preventDefault();
          clear();
        }
      });

      form.addEventListener("submit", (event) => {
        event.preventDefault();
        const first = content.querySelector("[data-result]");
        first?.click();
      });

      clearButton.addEventListener("click", clear);

      document.addEventListener("click", (event) => {
        if (!root.contains(event.target)) hideResults();
      });

      document.addEventListener("keydown", (event) => {
        const target = event.target;
        const typing =
          target instanceof HTMLElement &&
          (target.tagName === "INPUT" ||
            target.tagName === "TEXTAREA" ||
            target.tagName === "SELECT" ||
            target.isContentEditable);

        if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === "k") {
          event.preventDefault();
          input.focus();
          input.select();
        } else if (event.key === "/" && !typing) {
          event.preventDefault();
          input.focus();
        }
      });

      const initial = new URLSearchParams(window.location.search).get("q");
      if (initial) {
        input.value = initial;
        root.dataset.hasQuery = "true";
        search(initial.trim());
      } else if ("requestIdleCallback" in window) {
        window.requestIdleCallback(() => ensureLoaded(), { timeout: 2000 });
      } else {
        window.setTimeout(() => ensureLoaded(), 800);
      }
    }
  }
</script>
