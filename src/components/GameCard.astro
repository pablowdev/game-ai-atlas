---
import Icon from "./Icon.astro";
import type { GameView } from "../lib/data";
import type { Lang } from "../i18n/types";
import { ui } from "../i18n/ui";
import { routes } from "../i18n/routes";
import {
  formatRelative,
  formatYear,
  projectsCount
} from "../lib/format";
import { withBase } from "../lib/url";

interface Props {
  game: GameView;
  lang: Lang;
}

const { game, lang } = Astro.props;
const t = ui[lang];
const year = formatYear(game.year, lang);
const activity = formatRelative(game.lastActivity, lang);
const meta = [year, game.genres[0]].filter(Boolean).join(" · ");
const url = withBase(routes.game(lang, game.id));
---

<a class="card game-card" href={url}>
  <div>
    <div class="flex items-start justify-between gap-3">
      <div>
        <div class="game-card-title">{game.title}</div>
        <div class="game-card-meta">{meta || t.common.unknown}</div>
      </div>
      {game.wanted && <span class="badge badge-slate">{t.badges.wanted}</span>}
    </div>
  </div>
  <div class="game-card-footer">
    <span class="game-card-count">
      {game.projectCount > 0
        ? projectsCount(game.projectCount, lang)
        : lang === "es"
          ? "Buscamos proyectos"
          : "Looking for projects"}
    </span>
    {activity && (
      <span class="inline-flex items-center gap-1">
        <Icon name="clock" size={12} />
        {activity}
      </span>
    )}
  </div>
</a>
