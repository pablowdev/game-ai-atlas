---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icon from "../Icon.astro";
import { routes } from "../../i18n/routes";
import { otherLang, type Lang } from "../../i18n/types";
import { ui } from "../../i18n/ui";
import { getData } from "../../lib/data";
import {
  formatRelative,
  formatYear,
  projectsCount
} from "../../lib/format";
import { withBase } from "../../lib/url";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
const data = getData();
const initials = [...data.gamesByInitial.keys()].sort((a, b) => {
  if (a === "#") return 1;
  if (b === "#") return -1;
  return a.localeCompare(b);
});
---

<BaseLayout
  lang={lang}
  title={t.gamesIndex.title}
  description={t.gamesIndex.intro}
  canonicalPath={routes.games[lang]}
  alternatePath={routes.games[otherLang(lang)]}
>
  <section class="container-page detail-hero">
    <p class="hero-eyebrow">
      <Icon name="gamepad" size={14} />
      {t.gamesIndex.count(data.games.length)}
    </p>
    <h1 class="detail-title">{t.gamesIndex.title}</h1>
    <p class="detail-subtitle">{t.gamesIndex.intro}</p>

    <div class="search-shell max-w-xl">
      <div class="search-box">
        <Icon name="search" size={18} />
        <label class="sr-only" for="game-index-filter">
          {t.gamesIndex.search}
        </label>
        <input
          id="game-index-filter"
          class="search-input"
          type="search"
          placeholder={t.gamesIndex.search}
          autocomplete="off"
          data-game-filter
        />
        <span class="search-kbd" data-game-filter-count>
          {data.games.length}
        </span>
      </div>
    </div>
  </section>

  <section class="container-page section pt-2">
    {
      initials.map((initial) => {
        const games = data.gamesByInitial.get(initial) ?? [];
        return (
          <div data-game-group>
            <div class="group-heading">
              <span class="group-letter">{initial}</span>
              <span class="group-line" />
            </div>
            <div>
              {games.map((game) => (
                <a
                  class="game-index-row"
                  href={withBase(routes.game(lang, game.id))}
                  data-game-row
                  data-game-name={`${game.title} ${game.aliases.join(" ")}`.toLowerCase()}
                >
                  <span class="min-w-0">
                    <span class="game-index-title">{game.title}</span>
                    <span class="game-index-meta ml-2">
                      {[formatYear(game.year, lang), game.genres[0]]
                        .filter(Boolean)
                        .join(" · ")}
                    </span>
                  </span>
                  <span class="game-index-count">
                    {game.wanted
                      ? t.badges.wanted
                      : projectsCount(game.projectCount, lang)}
                    {game.lastActivity && (
                      <span class="block">
                        {formatRelative(game.lastActivity, lang)}
                      </span>
                    )}
                  </span>
                </a>
              ))}
            </div>
          </div>
        );
      })
    }

    <p class="empty-state-text mt-4 hidden text-left" data-game-filter-empty>
      {t.gamesIndex.noResults}
    </p>
  </section>
</BaseLayout>

<script>
  // @ts-nocheck — DOM script kept in plain JS for readability.
  const filter = document.querySelector("[data-game-filter]");
  if (filter) {
    const rows = [...document.querySelectorAll("[data-game-row]")];
    const groups = [...document.querySelectorAll("[data-game-group]")];
    const empty = document.querySelector("[data-game-filter-empty]");
    const counter = document.querySelector("[data-game-filter-count]");

    const normalize = (value) =>
      value
        .normalize("NFD")
        .replace(/\p{Diacritic}/gu, "")
        .toLowerCase();

    filter.addEventListener("input", () => {
      const query = normalize(filter.value.trim());
      let visible = 0;
      for (const row of rows) {
        const show = !query || normalize(row.dataset.gameName || "").includes(query);
        row.hidden = !show;
        if (show) visible++;
      }
      for (const group of groups) {
        group.hidden = ![...group.querySelectorAll("[data-game-row]")].some(
          (row) => !row.hidden
        );
      }
      if (empty) empty.classList.toggle("hidden", visible > 0);
      if (counter) counter.textContent = String(visible);
    });
  }
</script>
